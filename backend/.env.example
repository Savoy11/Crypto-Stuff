# ================================================================
# Crypto Asset Evaluation Platform — Environment Configuration
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ================================================================

# ----------------------------------------------------------------
# Application
# ----------------------------------------------------------------
APP_NAME="Crypto Asset Evaluation Platform"
APP_VERSION="1.0.0"
ENVIRONMENT=development        # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ----------------------------------------------------------------
# Security — CHANGE THESE IN PRODUCTION
# ----------------------------------------------------------------
SECRET_KEY=replace-with-64-char-random-secret-key-never-commit-this
ALGORITHM=HS256
# Keep this short. The revocation blocklist fails open when Redis is
# unreachable, so the expiry is the only bound on a logged-out or stolen token
# that always holds. Raising it back toward 30 reopens that window.
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7
# true = reject requests when the blocklist cannot be reached, turning a Redis
# outage into an auth outage. Only worth it with Redis deployed HA.
BLOCKLIST_FAIL_CLOSED=false

# ----------------------------------------------------------------
# Database (TimescaleDB / PostgreSQL)
# ----------------------------------------------------------------
# DB/user renamed caep → fn in the 2026-08 pre-production identity sweep.
# Installs from before then have data under caep/caep — either rename them
# (see docs/deployment/caep-db-rename.md) or point DATABASE_URL at the old names.
DATABASE_URL=postgresql+asyncpg://fn:fn@localhost:5432/fn
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ----------------------------------------------------------------
# Redis
# ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# ----------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ----------------------------------------------------------------
# CORS
# ----------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","https://app.financenow.example"]

# ----------------------------------------------------------------
# External Data Sources
# ----------------------------------------------------------------
COINGECKO_API_KEY=your-coingecko-api-key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

DEFILLAMA_BASE_URL=https://stablecoins.llama.fi
DEFILLAMA_PROTOCOL_URL=https://api.llama.fi

CHAINLINK_BASE_URL=https://cl-feeds.s3.amazonaws.com
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-infura-key

# ----------------------------------------------------------------
# Monitoring
# ----------------------------------------------------------------
PROMETHEUS_ENABLED=true
SENTRY_DSN=

# ----------------------------------------------------------------
# Scheduler
# ----------------------------------------------------------------
PIPELINE_MARKET_DATA_INTERVAL_MINUTES=5
PIPELINE_BLOCKCHAIN_INTERVAL_MINUTES=30
PIPELINE_RESERVES_INTERVAL_HOURS=6
SCORING_RECALCULATE_INTERVAL_MINUTES=15
