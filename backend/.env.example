# ================================================================
# Crypto Asset Evaluation Platform — Environment Configuration
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ================================================================

# ----------------------------------------------------------------
# Application
# ----------------------------------------------------------------
APP_NAME="Crypto Asset Evaluation Platform"
APP_VERSION="1.0.0"
ENVIRONMENT=development        # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ----------------------------------------------------------------
# Security — CHANGE THESE IN PRODUCTION
# ----------------------------------------------------------------
SECRET_KEY=replace-with-64-char-random-secret-key-never-commit-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------
# Database (TimescaleDB / PostgreSQL)
# ----------------------------------------------------------------
# DB name/user kept from the CAEP era — existing local installs have data there
DATABASE_URL=postgresql+asyncpg://caep:caep@localhost:5432/caep
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ----------------------------------------------------------------
# Redis
# ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# ----------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ----------------------------------------------------------------
# CORS
# ----------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","https://app.financenow.example"]

# ----------------------------------------------------------------
# External Data Sources
# ----------------------------------------------------------------
COINGECKO_API_KEY=your-coingecko-api-key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

DEFILLAMA_BASE_URL=https://stablecoins.llama.fi
DEFILLAMA_PROTOCOL_URL=https://api.llama.fi

CHAINLINK_BASE_URL=https://cl-feeds.s3.amazonaws.com
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-infura-key

# ----------------------------------------------------------------
# Monitoring
# ----------------------------------------------------------------
PROMETHEUS_ENABLED=true
SENTRY_DSN=

# ----------------------------------------------------------------
# Scheduler
# ----------------------------------------------------------------
PIPELINE_MARKET_DATA_INTERVAL_MINUTES=5
PIPELINE_BLOCKCHAIN_INTERVAL_MINUTES=30
PIPELINE_RESERVES_INTERVAL_HOURS=6
SCORING_RECALCULATE_INTERVAL_MINUTES=15
