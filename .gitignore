# Dependencies
node_modules/
**/node_modules/

# Next.js build output
frontend/.next/
frontend/out/

# Build artifacts
frontend/tsconfig.tsbuildinfo
**/*.tsbuildinfo

# Backup files
*.bak
*.bak.*

# Runtime config / secrets written by the app (defaults live in source)
frontend/.provider-config.json
frontend/.agent-prompts.json
frontend/.exchange-credentials.json
.provider-config.json
.agent-prompts.json
.exchange-credentials.json

# Environment files (keep .env.example, ignore secrets)
.env
.env.local
.env.*.local
frontend/.env.local
backend/.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/

# Docker
*.log

# Terraform (local init artifacts; do not commit)
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Ruff cache
.ruff_cache/
**/.ruff_cache/

# Claude Code config (machine-specific)
.claude/
**/.claude/

# OS
.DS_Store
Thumbs.db

# Python coverage artifacts
.coverage
backend/.coverage
backend/htmlcov/
backend/test-results.xml
