{
  "name": "finance-now-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "css:build": "tailwindcss -i ./src/app/globals.css -o ./src/app/globals.compiled.css",
    "css:watch": "tailwindcss -i ./src/app/globals.css -o ./src/app/globals.compiled.css --watch",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "smoke": "node scripts/test-live-data.mjs --quick",
    "audit": "node scripts/test-live-data.mjs",
    "audit:strict": "node scripts/test-live-data.mjs --strict",
    "audit:json": "node scripts/test-live-data.mjs --json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:status": "node scripts/db-status.mjs",
    "db:create": "node --env-file=.env.local scripts/db-create.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env.local scripts/db-seed.mjs",
    "restart": "npx kill-port 3000 & rmdir /s /q .next & npm run dev",
    "update": "git pull && npm install --no-audit --no-fund && npm run restart",
    "data-sources": "tsx scripts/gen-data-sources.ts",
    "fund-facts": "node scripts/build-fund-facts.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@tanstack/react-query": "^5.28.0",
    "autoprefixer": "^10.4.19",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.358.0",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^6.45.0",
    "postcss": "^8.4.38",
    "postgres": "^3.4.9",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.4.0",
    "recharts": "^2.12.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "undici": "^7.29.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "vitest": "^3.0.0"
  }
}
